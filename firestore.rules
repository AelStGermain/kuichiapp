rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla por defecto: denegar todo
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Regla para veterinarias:
    // - Cualquiera puede leer (si es una app pública) o solo autenticados (según requerimiento)
    // - Solo usuarios autenticados pueden escribir (crear, editar, eliminar)
    match /veterinarias/{veterinariaId} {
      allow read: if true; // O if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Regla para usuarios:
    // - Usuarios autenticados pueden leer/escribir su propio documento
    // - Sistema puede crear documentos de usuario durante registro/login
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; // Permitir creación al hacer login
    }
  }
}
